CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_LWIP_IPV6=n
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="@AVM_PARTITION_TABLE_FILENAME@"
CONFIG_APP_REPRODUCIBLE_BUILD=y

# ESP32-S3-MINI-1-N4R2 and other -R modules carry external PSRAM. Plain malloc
# is served from it above SPIRAM_MALLOC_ALWAYSINTERNAL; MALLOC_CAP_DMA
# allocations stay internal. IGNORE_NOTFOUND keeps modules without PSRAM booting.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# TLS handshakes allocate many small bignums; internal RAM alone runs out
# against a full certificate chain, and mbedtls_ssl_setup answers
# MBEDTLS_ERR_SSL_ALLOC_FAILED without this.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Size the TLS record buffers to the handshake in progress rather than holding
# 16K in and 4K out for the life of every connection.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# libsodium's Ed25519 verification overflows the 3584-byte default main task
# stack. The symptom is a reset on the first update, not a bad-signature report.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384


# ngrok's edge negotiates TLS 1.3 by default and refuses the legacy 1.2-only
# ClientHello mbedTLS sends without this, closing before any alert.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y

# -Og left the VM at 98.2% of `factory`, which TLS 1.3 then overflowed by 384
# bytes. Assertions are a separate knob and stay on.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
